APP_NAME=Laravel
APP_ENV=local
PROMOTION_RULE_ENGINE_ENABLED=true
APP_KEY=
# En la terminal del POS dejar en false: con true Laravel guarda el backtrace de CADA consulta.
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC
BUSINESS_TIMEZONE=America/Mexico_City

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# `file` evita una consulta a MySQL por request. `database` solo si hay varios servidores web.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# `file` (o `redis` si esta disponible). Con `database` cada lectura de cache es una consulta a MySQL:
# son 5 consultas extra por cada click del POS.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@tu-dominio-verificado.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Realtime Database (canal efímero; MySQL sigue siendo la fuente de verdad)
FIREBASE_REALTIME_ENABLED=false
FIREBASE_DATABASE_URL=
# FIREBASE_WEB_CONFIG_PATH=/ruta/absoluta/firebaseconfig.txt
# FIREBASE_CREDENTIALS_PATH=/ruta/segura/firebase-service-account.json
FIREBASE_REALTIME_ROOT=notifications
FIREBASE_REALTIME_TIMEOUT=3
FIREBASE_REALTIME_CLEANUP_TIME=00:00
FIREBASE_REALTIME_CLEANUP_TIMEZONE=America/Mexico_City
FIREBASE_PULSE_THROTTLE_SECONDS=300

# Pulse agrega 2 INSERT por request. Desactivarlo en la terminal del POS.
PULSE_ENABLED=false
PULSE_PATH=pulse
